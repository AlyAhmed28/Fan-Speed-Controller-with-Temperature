#include"lm35.h"
#include"adc.h"
#include"lcd.h"
#include"dcmotor.h"
#include<util/delay.h>



int main()
{
	uint8 temp;
	ADC_ConfigType config = {F_CPU_8,INTERNAL};

	LCD_init();

	ADC_init(&config);

	while(1)
	{
		temp = LM35_getTemperature();

		LCD_integerToString(temp);

	}

}
