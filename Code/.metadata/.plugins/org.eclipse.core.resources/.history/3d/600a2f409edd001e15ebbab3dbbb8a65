#include"adc.h"
#include"gpio.h"
#include"common_macros.h"
#include<avr/io.h>



void ADC_init(void)
{

	ADMUX = 0;

	ADCSRA |= (1<<ADEN) | (1<<ADPS0) | (1<<ADPS1);

}


uint16 ADC_readChannel(uint8 channel)
{
	channel &= 0x07;
	ADMUX &= 0xE0;

	ADMUX = ADMUX | channel;

	SET_BIT(ADCSRA,ADSC);

	while(BIT_IS_CLEAR(ADCSRA,ADIF));

	SET_BIT(ADCSRA,ADIF);

	return ADC;
}
