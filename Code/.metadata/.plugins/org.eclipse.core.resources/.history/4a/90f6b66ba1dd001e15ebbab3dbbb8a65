#include"adc.h"
#include"gpio.h"
#include"common_macros.h"
#include<avr/io.h>



void ADC_init(ADC_ConfigType *config)
{

	ADMUX = (ADMUX & 0x3F) | ((config->ref_volt)<<6);

	ADCSRA = (ADCSRA & 0xF8) | (config->prescaler);

	ADCSRA |= (1<<ADEN);

}


uint16 ADC_readChannel(uint8 channel)
{
	channel &= 0x07;
	ADMUX &= 0xE0;

	ADMUX = ADMUX | channel;

	SET_BIT(ADCSRA,ADSC);

	while(BIT_IS_CLEAR(ADCSRA,ADIF));

	SET_BIT(ADCSRA,ADIF);

	return ADC;
}
